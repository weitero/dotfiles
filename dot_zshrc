source /usr/local/opt/zinit/zinit.zsh

zinit light zdharma-continuum/zinit-annex-bin-gem-node

zinit wait lucid for \
zdharma/history-search-multi-word \
atload"bindkey '^[[A' history-substring-search-up;bindkey '^[[B' history-substring-search-down" zsh-users/zsh-history-substring-search \
zsh-users/zsh-autosuggestions


zinit wait lucid for \
OMZL::completion.zsh \
OMZL::correction.zsh \
OMZP::brew \
OMZP::cp \
OMZP::git \
OMZP::pip \
atload"export ZSH_TMUX_ITERM2=true" OMZP::tmux


zinit ice from"gh-r" fbin"starship" \
atclone"./starship init zsh > init.zsh; ./starship completions zsh > _starship" \
atpull"%atclone" src"init.zsh"
zinit light starship/starship

zinit ice atload"unalias lsa l ll la"
zinit snippet OMZL::directories.zsh

zinit ice wait lucid \
from'gh-r' as'command' bpick'FontPatcher.zip' pick'font-patcher'  \
atclone"sed -i '' '1s/python$/python3/' font-patcher" atpull"%atclone"
zinit light ryanoasis/nerd-fonts

zinit wait lucid atinit'zicompinit' for \
zdharma/fast-syntax-highlighting \

zinit wait lucid \
atclone"mkdir -p $ZPFX/bin" \
atclone"./fzf --zsh |sed -n '/### completion/,/### end: completion/p' > _fzf_completion" \
atclone"./fzf --zsh |sed -n '/### key-bindings/,/### end: key-bindings/p' > key-bindings.zsh" \
atpull"%atclone" \
from'gh-r' \
sbin'fzf' \
src"key-bindings.zsh" \
for @junegunn/fzf

alias q='exit'
alias vi='nvim'
alias vim='nvim'

alias l='eza -gF -sName --group-directories-first --git'
alias la='l -a'
alias ldd='l -aD'
alias ldi='l -D'
alias ldot='l -d .*'
alias ll='l -l'
alias lla='l -la'
alias ls='l -ssize'
alias lsd='l -d'
alias lsdl='l -ld'
alias lt='l -snewest'

alias cp='cp -aiv'
alias mv='mv -iv'
alias rm='rm -iv'

alias kat='cat -enstv'
alias kurl='curl -LZJOR --compressed'
alias les='less -FgiJmNsSw --incsearch --mouse --use-color'
