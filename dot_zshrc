ZSH_AUTOSUGGEST_MANUAL_REBIND=1

ZIM_HOME=${ZDOTDIR:-${HOME}}/.zim
# Install missing modules and update ${ZIM_HOME}/init.zsh if missing or outdated.
if [[ ! ${ZIM_HOME}/init.zsh -nt ${ZIM_CONFIG_FILE:-${ZDOTDIR:-${HOME}}/.zimrc} ]]; then
	source /opt/homebrew/opt/zimfw/share/zimfw.zsh init
fi
# Initialize modules.
source ${ZIM_HOME}/init.zsh

alias q='exit'
alias vi='nvim'
alias vim='nvim'

alias l='eza -gF -sName --group-directories-first --git'
alias la='l -a'
alias ldd='l -aD'
alias ldi='l -D'
alias ldot='l -d .*'
alias ll='l -l'
alias lla='l -la'
alias ls='l -ssize'
alias lsd='l -d'
alias lsdl='l -ld'
alias lt='l -snewest'

alias cp='cp -aiv'
alias mv='mv -iv'
alias rm='rm -iv'

alias kat='cat -enstv'
alias kurl='curl -LZJOR --compressed'
alias les='less -FgiJmNsSw --incsearch --mouse --use-color'
